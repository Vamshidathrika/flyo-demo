#!/usr/bin/env bash
# ==============================================================================
# agent-eval — Flyo Rescue CLI Benchmarking Runner
# ==============================================================================
set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Prefer project Python virtual environment if present
if [ -x "${ROOT_DIR}/ml/.venv/bin/python" ]; then
    PYTHON_EXEC="${ROOT_DIR}/ml/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_EXEC="$(command -v python3)"
else
    echo "[ERROR] python3 not found in PATH." >&2
    exit 1
fi

exec "${PYTHON_EXEC}" "${ROOT_DIR}/scripts/agent_eval_runner.py" "$@"
