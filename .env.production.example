# =================================================================
# FLYO ENTERPRISE PRODUCTION CONFIGURATION TEMPLATE
# DO NOT COMMIT ACTUAL PRODUCTION SECRETS TO SOURCE CONTROL
# =================================================================

# 1. Database & Persistence Layer (PostgreSQL 16)
POSTGRES_DB=flyodb
POSTGRES_USER=flyo_admin
POSTGRES_PASSWORD=replace_with_strong_random_db_password_min32chars
SPRING_DATASOURCE_URL=jdbc:postgresql://flyo-db:5432/flyodb
SPRING_DATASOURCE_USERNAME=flyo_admin
SPRING_DATASOURCE_PASSWORD=replace_with_strong_random_db_password_min32chars

# 2. Redis Distributed Cache & Locks (Redis 7)
REDIS_PASSWORD=replace_with_strong_random_redis_password_min32chars
SPRING_DATA_REDIS_HOST=flyo-redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=replace_with_strong_random_redis_password_min32chars

# 3. Security & Cryptography
FLYO_SECURITY_JWT_SECRET=replace_with_minimum_32_byte_cryptographic_key_hex_or_base64
FLYO_SECURITY_JWT_EXPIRATION_MS=3600000

# 4. GDS & Airline Integration (Amadeus / Altea / Navitaire)
AIRLINE_BOOKING_PROVIDER=SANDBOX
AMADEUS_CLIENT_ID=your_amadeus_sandbox_or_live_api_key
AMADEUS_CLIENT_SECRET=your_amadeus_sandbox_or_live_api_secret

# 5. WhatsApp Cloud API (Meta)
WHATSAPP_META_ENABLED=true
WHATSAPP_META_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_META_ACCESS_TOKEN=your_meta_system_user_permanent_token
WHATSAPP_META_APP_SECRET=your_meta_app_secret_for_hmac_sha256
WHATSAPP_META_VERIFY_TOKEN=flyo_whatsapp_verify_token_2026

# 6. Corporate CRM (Salesforce Service Cloud)
SALESFORCE_CLIENT_ID=your_salesforce_connected_app_client_id
SALESFORCE_CLIENT_SECRET=your_salesforce_connected_app_client_secret
SALESFORCE_INSTANCE_URL=https://your-company.my.salesforce.com

# 7. Server Runtime Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
